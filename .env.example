DB_URL=jdbc:mysql://127.0.0.1:3306/ai_scheduler?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true
DB_USERNAME=ai_scheduler_app
DB_PASSWORD=replace-with-your-database-password
S3_BUCKET=replace-with-your-s3-bucket
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=replace-with-your-access-key
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-key
S3_PRESIGNED_URL_MINUTES=10
# MinIO 등 S3 호환 스토리지를 사용할 때만 설정
S3_ENDPOINT=
AI_BASE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=60
APP_AUTH_COOKIE_SECURE=true
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/kakao/callback
KAKAO_FRONTEND_REDIRECT_URI=http://localhost:5173/oauth/callback
