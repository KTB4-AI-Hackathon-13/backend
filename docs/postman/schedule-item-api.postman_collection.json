                "{{baseUrl}}"
              ],
              "path": [
                "schedules",
                "101",
                "items"
              ]
            },
            "description": "seed 기준 user1 의 8/19 작업은 3건(1004,1005 @101, 1302 @104). position 미지정 → 같은 스케줄·날짜의 다음 순번.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"새 작업 A\",\n  \"scheduledDate\": \"2026-08-19\",\n  \"categoryId\": 1,\n  \"workload\": 2,\n  \"priority\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"meta.requestId 존재\", () => pm.expect(pm.response.json().meta.requestId).to.be.a(\"string\"));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"필드\", () => pm.expect(d).to.include.keys(\"id\",\"scheduleId\",\"title\",\"scheduledDate\",\"position\",\"workload\",\"priority\",\"status\",\"completedAt\"));",
                  "pm.test(\"status TODO, position 2\", () => { pm.expect(d.status).to.eql(\"TODO\"); pm.expect(d.position).to.eql(2); });",
                  "pm.collectionVariables.set(\"newItemId\", d.id);"
                ]
              }
            }
          ]
