            "url": {
              "raw": "{{baseUrl}}/calendar?year=2026&month=8",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "calendar"
              ],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "8"
                }
              ]
            },
            "description": "작업이 있는 날짜만 days 에 포함. 여러 스케줄의 작업이 섞여 나옴(scheduleTitle 포함). 삭제된 스케줄(105)/작업(1008) 제외."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"year/month\", () => { pm.expect(d.year).to.eql(2026); pm.expect(d.month).to.eql(8); });",
                  "pm.test(\"days 구조\", () => { pm.expect(d.days[0]).to.include.keys(\"date\",\"totalCount\",\"completedCount\",\"items\"); pm.expect(d.days[0].items[0]).to.include.keys(\"id\",\"scheduleId\",\"scheduleTitle\",\"title\",\"status\",\"priority\"); });",
                  "pm.test(\"삭제 스케줄 작업(1401)/삭제 작업(1008) 미포함\", () => { const ids=d.days.flatMap(x=>x.items.map(i=>i.id)); pm.expect(ids).to.not.include(1401); pm.expect(ids).to.not.include(1008); });",
                  "pm.test(\"8월 날짜만\", () => d.days.forEach(x => pm.expect(x.date).to.match(/^2026-08-/)));"
                ]
              }
            }
          ]
