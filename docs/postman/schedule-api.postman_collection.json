      "name": "1. 스케줄 목록 GET /schedules",
      "item": [
        {
          "name": "목록 - 기본",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "description": "임시 인증 헤더 (세션 도입 전)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedules"
              ]
            },
            "description": "status/size/cursor 없이 전체. 소프트삭제(105)는 안 나와야 함. 각 항목에 puzzleCount/completedPuzzleCount 포함."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"meta.requestId 존재\", () => pm.expect(pm.response.json().meta.requestId).to.be.a(\"string\"));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"items/nextCursor/hasNext 구조\", () => { pm.expect(d).to.have.keys(\"items\",\"nextCursor\",\"hasNext\"); });",
                  "pm.test(\"삭제된 스케줄(105) 미포함\", () => pm.expect(d.items.map(i=>i.id)).to.not.include(105));",
                  "pm.test(\"퍼즐 수 필드 존재\", () => { pm.expect(d.items[0]).to.have.property(\"puzzleCount\"); pm.expect(d.items[0]).to.have.property(\"completedPuzzleCount\"); });",
                  "pm.test(\"id 내림차순\", () => { const ids=d.items.map(i=>i.id); pm.expect(ids).to.eql([...ids].sort((a,b)=>b-a)); });",
                  "pm.test(\"항목은 설계서 8개 필드만\", () => pm.expect(Object.keys(d.items[0]).sort()).to.eql([\"completedPuzzleCount\",\"currentVersion\",\"endDate\",\"id\",\"puzzleCount\",\"startDate\",\"status\",\"title\"]));",
                  "pm.test(\"101 puzzleCount 7 (삭제 1·취소 1 제외)\", () => { const s=d.items.find(i=>i.id===101); pm.expect(s.puzzleCount).to.eql(7); pm.expect(s.completedPuzzleCount).to.eql(2); });"
                ]
              }
            }
          ]
        },
