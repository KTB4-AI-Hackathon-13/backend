    {
      "name": "2. 스케줄 상세 GET /schedules/{scheduleId}",
      "item": [
        {
          "name": "상세 - 101",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}",
                "description": "임시 인증 헤더 (세션 도입 전)"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedules/{{scheduleId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "schedules",
                "{{scheduleId}}"
              ]
            },
            "description": "계획 요약(설계서 8개 필드) + days[](날짜별 작업, position→priority→id 정렬) + 퍼즐 수(CANCELLED 제외). 소프트삭제 작업(1008)은 안 나와야 함."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"meta.requestId 존재\", () => pm.expect(pm.response.json().meta.requestId).to.be.a(\"string\"));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"요약 필드\", () => pm.expect(d).to.include.keys(\"id\",\"title\",\"status\",\"startDate\",\"endDate\",\"currentVersion\",\"puzzleCount\",\"completedPuzzleCount\",\"days\"));",
                  "pm.test(\"days 날짜 오름차순\", () => { const ds=d.days.map(x=>x.date); pm.expect(ds).to.eql([...ds].sort()); });",
                  "pm.test(\"삭제된 작업(1008) 미포함\", () => { const ids=d.days.flatMap(x=>x.items.map(i=>i.id)); pm.expect(ids).to.not.include(1008); });",
                  "pm.test(\"puzzleCount == 유효 작업 수(CANCELLED 제외)\", () => { const n=d.days.flatMap(x=>x.items).filter(i=>i.status!==\"CANCELLED\").length; pm.expect(d.puzzleCount).to.eql(n); });",
                  "pm.test(\"설계서 8개 필드 + days (source/createdAt 없음)\", () => { pm.expect(d).to.not.have.property(\"source\"); pm.expect(d).to.not.have.property(\"createdAt\"); });",
                  "pm.test(\"같은 날짜 안 position 오름차순\", () => d.days.forEach(x => { const ps=x.items.map(i=>i.position); pm.expect(ps).to.eql([...ps].sort((a,b)=>a-b)); }));"
                ]
              }
            }
          ]
        },
